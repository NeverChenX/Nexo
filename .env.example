# 站点公开 URL（用于生成分享链接、剪藏 bookmarklet 等）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── 大模型（火山方舟 / Volcano Ark / Doubao）───
# 所有 AI 功能（写作 / 问答 / 解释 / 分类）统一走这里。
# 读取优先级：ARK_* (env) > wiki-data/_config/llm.json（通过设置页写入） > 代码默认
# 未配置时 AI 功能将提示「请先到 设置 → AI 模型 中填入 API Key」
ARK_API_KEY=replace-with-your-volcano-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-flash-250828

# 外部 API 调用密钥（通过 Authorization: Bearer <key> 传递；可用 openssl rand -hex 32 生成）
WIKI_API_KEY=replace-with-a-long-random-hex-string

# 已废弃：OpenClaw AI 网关（保留仅为向后兼容，可不配置）
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-your-gateway-token
